{
  "name": "@nirvanacp/sdk",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "default": "./dist/react.js"
    },
    "./router": {
      "types": "./dist/types/router/index.d.ts",
      "default": "./dist/router.js"
    },
    "./page": {
      "types": "./dist/types/page/index.d.ts",
      "default": "./dist/page.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node build.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@nirvanacp/core": "0.2.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirvanacp/let.git",
    "directory": "packages/sdk"
  }
